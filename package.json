{
  "name": "assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @assistant/api",
    "dev:web": "npm run dev -w @assistant/web",
    "db:migrate": "npm run db:migrate -w @assistant/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
