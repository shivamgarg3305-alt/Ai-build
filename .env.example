# PAPPU API configuration template.
#
# Copy with `npm run setup` (recommended): it creates `.env` from this file and fills
# SESSION_SECRET with a fresh random value. Never put real credentials in THIS file;
# it is committed to Git. `.env` itself is git-ignored.
#
# The API reads `.env` from its working directory or the repository root.
# Every value is validated at startup (apps/api/src/env.ts); invalid config stops the API.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Loopback by default. Use 0.0.0.0 only if you deliberately want LAN access.
API_HOST=127.0.0.1
API_PORT=8787

# Paths are relative to apps/api.
DATABASE_PATH=./data/assistant.db
STORAGE_DIR=./data/storage

# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---- Sessions --------------------------------------------------------------
# Required, at least 32 characters. Left empty here on purpose:
# `npm run setup` generates a random value in your local .env.
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=720

# ---- AI provider (OFF) -----------------------------------------------------
# Live AI stays OFF. PAPPU sends nothing to any AI provider unless all three switches
# below are set by the owner, and activation is currently blocked pending the
# compliance and privacy review (see docs/AI_PROVIDER.md and docs/ARCHITECTURE.md).
AI_ENABLED=false
GEMINI_TERMS_REVIEWED=false
# GEMINI_API_KEY=
# Optional tuning (defaults shown):
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_RETRIES=1
# AI_RETRY_BACKOFF_MS=800
# AI_TEMPERATURE=0.7
# AI_MAX_OUTPUT_TOKENS=2048
# AI_CONTEXT_MAX_MESSAGES=30
# AI_CONTEXT_MAX_CHARS=24000
# AI_REQUESTS_PER_MINUTE=6
# AI_REQUESTS_PER_DAY=100
# AI_TOKENS_PER_DAY=300000
# AI_QUOTA_TIMEZONE=America/Los_Angeles

# ---- Web app (build time) --------------------------------------------------
# Not read from this file. Vite reads VITE_* variables from the shell or from
# apps/web/.env* at build time. Leave unset in development (Vite proxies /api).
# VITE_API_BASE_URL=
