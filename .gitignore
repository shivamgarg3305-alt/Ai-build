# ---------------------------------------------------------------------------
# PAPPU repository ignore rules.
# Anything that can hold secrets, personal data or generated output stays out of Git.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment files and secrets (the placeholder template IS committed)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets/
.secrets/

# Local data: databases, uploaded files, exports, backups
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
backups/
exports/

# Cloudflare Wrangler local state (local D1, caches)
.wrangler/

# Test and coverage output
coverage/
.vitest/
*.lcov

# Logs and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.tmp/
*.tmp
*.swp
*.swo
*~

# Editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code per-user settings (may hold personal configuration)
.claude/settings.local.json
